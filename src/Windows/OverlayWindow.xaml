<Window x:Class="AdvancedInputOverlay.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AdvancedInputOverlay.Controls"
        Title="Overlay"
        Icon="/Resources/app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Faux title bar — only visible in Window Mode ON.
             The non-button area of this row becomes native drag thanks to WindowChrome.CaptionHeight. -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="#202325"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        x:Name="CloseButton"
                        Content="&#xE8BB;"
                        FontFamily="{StaticResource FluentIcons}"
                        FontSize="12"
                        Width="40"
                        Background="Transparent"
                        Foreground="#DDD"
                        BorderThickness="0"
                        Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"/>
                <TextBlock x:Name="TitleText"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="#DDD"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Content area with thin border (left/right/bottom) when in Window Mode ON.
             Viewbox scales OverlayCanvas uniformly to fit the available space. -->
        <Border Grid.Row="1"
                x:Name="ContentBorder"
                BorderBrush="#3A3F44"
                BorderThickness="0"
                Background="Transparent">
            <Viewbox x:Name="ContentBox"
                     Stretch="Uniform"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch">
                <controls:OverlayCanvas x:Name="Canvas"
                                        Background="Transparent"/>
            </Viewbox>
        </Border>
    </Grid>
</Window>
