<Window x:Class="AdvancedInputOverlay.Windows.AddOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Overlay"
        Icon="/Resources/app.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Name" Margin="0,0,0,4"/>
        <TextBox Grid.Row="2" x:Name="NameBox" Padding="4" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Overlay image" Margin="0,0,0,4"/>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ImageBox" Padding="4"/>
            <Button Grid.Column="1" Content="Browse..." Padding="8,4" Margin="6,0,0,0" Click="BrowseImage_Click"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="Overlay config (json)" Margin="0,0,0,4"/>
        <Grid Grid.Row="6" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LayoutBox" Padding="4"/>
            <Button Grid.Column="1" Content="Browse..." Padding="8,4" Margin="6,0,0,0" Click="BrowseLayout_Click"/>
        </Grid>

        <TextBlock Grid.Row="7" x:Name="ErrorText" Foreground="#C0392B" Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save"   IsDefault="True" Padding="14,6" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
